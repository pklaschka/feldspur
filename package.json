{
  "name": "feldspur",
  "version": "0.1.0",
  "private": true,
  "description": "Multimediale Feldaufzeichnungen auf einer gemeinsamen Zeitachse zusammenführen",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "check": "vp check && tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "fix": "vp check --fix",
    "probe": "vpx scripts/probe-folder.ts",
    "desktop": "vp run @feldspur/desktop#build && vp run @feldspur/desktop#start",
    "e2e": "vp run @feldspur/desktop#e2e"
  },
  "devDependencies": {
    "@feldspur/core": "workspace:*",
    "@feldspur/media": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
